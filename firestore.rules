rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function myRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        myRole().role == 'superAdmin';
    }
    function isInstitutionAdminOf(instId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        myRole().role == 'institutionAdmin' &&
        myRole().institutionId == instId;
    }
    function isCrOf(instId, courseId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        myRole().role == 'cr' &&
        myRole().institutionId == instId &&
        myRole().courseId == courseId;
    }
    function isLecturerOf(instId, courseId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/lecturerAssignments/$(request.auth.uid + '_' + instId + '_' + courseId));
    }

    // ── Role assignments ────────────────────────────────────────────
    match /userRoles/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isSuperAdmin() ||
         (exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && myRole().role == 'institutionAdmin'));
      allow create, update: if isSuperAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
         myRole().role == 'institutionAdmin' &&
         request.resource.data.role == 'cr' &&
         request.resource.data.institutionId == myRole().institutionId);
      allow delete: if isSuperAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
         myRole().role == 'institutionAdmin' &&
         resource.data.role == 'cr' &&
         resource.data.institutionId == myRole().institutionId);
    }

    // ── User profiles ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isSuperAdmin() ||
         (resource.data.institutionId != null && isInstitutionAdminOf(resource.data.institutionId)) ||
         (resource.data.institutionId != null && resource.data.courseId != null &&
          isCrOf(resource.data.institutionId, resource.data.courseId)));
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isSuperAdmin() ||
         (resource.data.institutionId != null && isInstitutionAdminOf(resource.data.institutionId)) ||
         (resource.data.institutionId != null && resource.data.courseId != null &&
          isCrOf(resource.data.institutionId, resource.data.courseId)));
      allow delete: if isSuperAdmin();
    }

    // ── Course catalog ──────────────────────────────────────────────
    match /institutions/{institutionId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
    match /institutions/{institutionId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() || isInstitutionAdminOf(institutionId);
    }

    // ── Course rosters ──────────────────────────────────────────────
    match /courseRosters/{courseId}/pendingStudents/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == studentId;
      allow update, delete: if isSuperAdmin() ||
        (resource.data.institutionId != null && isInstitutionAdminOf(resource.data.institutionId)) ||
        (resource.data.institutionId != null && resource.data.courseId != null &&
         isCrOf(resource.data.institutionId, resource.data.courseId));
    }

    // ── Announcements + read receipts ───────────────────────────────
    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        ( (request.resource.data.level == "institution" &&
           isInstitutionAdminOf(request.resource.data.institutionId)) ||
          (request.resource.data.level == "course" &&
           (isCrOf(request.resource.data.institutionId, request.resource.data.courseId) ||
            isLecturerOf(request.resource.data.institutionId, request.resource.data.courseId))) );
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      match /reads/{uid} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid ||
           get(/databases/$(database)/documents/announcements/$(annId)).data.createdBy == request.auth.uid);
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Polls + votes ───────────────────────────────────────────────
    match /polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        isCrOf(request.resource.data.institutionId, request.resource.data.courseId);
      allow update: if (request.auth != null && resource.data.createdBy == request.auth.uid) ||
        (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCounts']));
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      match /votes/{uid} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid ||
           get(/databases/$(database)/documents/polls/$(pollId)).data.createdBy == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Quick Collect forms ─────────────────────────────────────────
    match /collectForms/{formId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        isCrOf(request.resource.data.institutionId, request.resource.data.courseId);
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      match /submissions/{subId} {
        allow read: if request.auth != null &&
          (resource.data.submittedBy == request.auth.uid ||
           get(/databases/$(database)/documents/collectForms/$(formId)).data.createdBy == request.auth.uid);
        allow create: if request.auth != null && request.auth.uid == subId;
        allow update: if request.auth != null && request.auth.uid == subId && resource.data.submittedBy == request.auth.uid;
      }
    }

    // ── Poster Templates ───────────────────────────────────────────
    // Super Admin creates/manages; CR, Institution Admin, Lecturer read.
    match /posterTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Course Change Requests ──────────────────────────────────────
    // Students create; CR / Institution Admin approve or reject.
    match /courseChangeRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (isCrOf(request.resource.data.institutionId, request.resource.data.courseId) ||
         isInstitutionAdminOf(request.resource.data.institutionId) ||
         isSuperAdmin());
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // ── Notifications ───────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Lecturer assignments ────────────────────────────────────────
    match /lecturerAssignments/{assignmentId} {
      allow read: if request.auth != null &&
        (resource.data.lecturerUid == request.auth.uid || isSuperAdmin() || isInstitutionAdminOf(resource.data.institutionId));
      allow create: if request.auth != null &&
        (isSuperAdmin() || isInstitutionAdminOf(request.resource.data.institutionId));
      allow delete: if request.auth != null &&
        (isSuperAdmin() || isInstitutionAdminOf(resource.data.institutionId));
    }

    // ── Dashboard banner images ─────────────────────────────────────
    match /instBanners/{institutionId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ── Attendance sessions + checkins ──────────────────────────────
    match /attendanceSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (isCrOf(request.resource.data.institutionId, request.resource.data.courseId) ||
         isLecturerOf(request.resource.data.institutionId, request.resource.data.courseId));
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      match /checkins/{uid} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid ||
           get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data.createdBy == request.auth.uid);
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Sequential student-ID counters ──────────────────────────────
    match /idCounters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Everything else: locked down ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

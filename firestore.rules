rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== HELPER FUNCTIONS ======
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role;
    }

    function getMyInstId() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.institutionId;
    }

    function getMyCourseId() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.courseId;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == "superAdmin";
    }

    function isInstitutionAdmin(instId) {
      return isSignedIn() && getRole() == "institutionAdmin" && getMyInstId() == instId;
    }

    function isCR(instId, courseId) {
      return isSignedIn() && getRole() == "cr" && getMyInstId() == instId && getMyCourseId() == courseId;
    }

    function isLecturer(instId, courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/lecturerAssignments/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/lecturerAssignments/$(request.auth.uid)).data.institutionId == instId &&
        get(/databases/$(database)/documents/lecturerAssignments/$(request.auth.uid)).data.courseId == courseId;
    }

    // ====== USERS ======
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || isAdmin()
        || (isSignedIn() && getRole() == "institutionAdmin" &&
            get(/databases/$(database)/documents/users/$(userId)).data.institutionId == getMyInstId())
        || (isSignedIn() && getRole() == "cr" &&
            get(/databases/$(database)/documents/users/$(userId)).data.courseId == getMyCourseId());
      allow delete: if isAdmin();
    }

    // ====== USER ROLES ======
    match /userRoles/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstitutionAdmin("");
    }

    // ====== INSTITUTIONS ======
    match /institutions/{instId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /campuses/{campusId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isInstitutionAdmin(instId);

        match /courses/{courseId} {
          allow read: if isSignedIn();
          allow write: if isAdmin() || isInstitutionAdmin(instId);
        }
      }
    }

    // ====== LECTURER ASSIGNMENTS ======
    match /lecturerAssignments/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstitutionAdmin("");
    }

    // ====== REGISTRATION REQUESTS ======
    match /registrationRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ====== ANNOUNCEMENTS ======
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ====== COURSE CHANGE REQUESTS ======
    match /courseChangeRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ====== FEEDBACK ======
    match /feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ====== POLLS ======
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /responses/{responseId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isOwner(responseId);
      }
    }

    // ====== COLLECT FORMS ======
    match /collectForms/{formId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /submissions/{submissionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
      }
    }

    // ====== ATTENDANCE ======
    match /attendance/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      match /checkins/{checkinId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
      }
    }

    // ====== TEMPLATE FOLDERS ======
    match /templateFolders/{folderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ====== INSTITUTION BANNERS ======
    match /instBanners/{instId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ====== POSTER TEMPLATES ======
    match /posterTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ====== ID COUNTERS ======
    match /idCounters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

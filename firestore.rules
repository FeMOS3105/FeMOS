rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getRole() { return isSignedIn() ? get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role : ""; }
    function getMyInstId() { return isSignedIn() ? get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.institutionId : ""; }
    function getMyCourseId() { return isSignedIn() ? get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.courseId : ""; }
    function isAdmin() { return isSignedIn() && getRole() == 'superAdmin'; }
    function isInstitutionAdmin(instId) { return isSignedIn() && getRole() == 'institutionAdmin' && getMyInstId() == instId; }
    function isCR(instId, courseId) { return isSignedIn() && getRole() == 'cr' && getMyInstId() == instId && getMyCourseId() == courseId; }
    function isLecturer(instId, courseId) { return isSignedIn() && getRole() == 'lecturer' && getMyInstId() == instId && getMyCourseId() == courseId; }
    function isInInstitution(instId) { return isSignedIn() && getMyInstId() == instId; }
    function isInCourse(instId, courseId) { return isSignedIn() && getMyInstId() == instId && getMyCourseId() == courseId; }

    // ========== USERS ==========
    match /users/{userId} {
      // Owner can always read their own doc
      allow read: if isOwner(userId);
      // Super admin can read anyone
      allow read: if isAdmin();
      // Institution admins can read users in their institution
      allow read: if isInstitutionAdmin(resource.data.institutionId);
      // CR can read users in their course
      allow read: if isCR(resource.data.institutionId, resource.data.courseId);
      // Users can create their own doc (registration + signup)
      allow create: if isOwner(userId);
      // Users can update own doc; super admin can update anyone
      allow update: if isOwner(userId) || isAdmin();
      // Users can delete their own doc (delete registration)
      allow delete: if isOwner(userId);
    }

    // ========== USER ROLES ==========
    match /userRoles/{uid} {
      // Any signed-in user can read roles (needed to find CR, admin, etc.)
      allow read: if isSignedIn();
      // Only super admin can create/update/delete roles
      allow write: if isAdmin();
    }

    // ========== INSTITUTIONS ==========
    match /institutions/{instId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /campuses/{campusId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();

        match /courses/{courseId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }

    // ========== INST BANNERS ==========
    match /instBanners/{instId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstitutionAdmin(instId);
    }

    // ========== ANNOUNCEMENTS ==========
    match /announcements/{annId} {
      allow read: if isSignedIn();
      // CR, lecturer, institution admin, or super admin can create
      allow create: if isSignedIn();
      // Creator or admin can update/delete
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /reads/{readerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == readerId;
      }
    }

    // ========== POLLS ==========
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /votes/{voterId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == voterId;
      }
    }

    // ========== COLLECT FORMS ==========
    match /collectForms/{formId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /submissions/{subId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == subId;
      }
    }

    // ========== COURSE ROSTERS ==========
    match /courseRosters/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ========== POSTER TEMPLATES ==========
    match /posterTemplates/{tplId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ========== COURSE CHANGE REQUESTS ==========
    match /courseChangeRequests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ========== NOTIFICATIONS ==========
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ========== LECTURER ASSIGNMENTS ==========
    match /lecturerAssignments/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ========== ATTENDANCE SESSIONS ==========
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      match /checkins/{checkinId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == checkinId;
      }
    }

    // ========== ID COUNTERS ==========
    match /idCounters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ========== FEEDBACK ==========
    match /feedback/{fbId} {
      // Any authenticated user can create feedback
      allow create: if isSignedIn();
      // Only the recipient can read their feedback
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      // Recipient can update (mark as read)
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // ========== ADMINS (seed script) ==========
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
